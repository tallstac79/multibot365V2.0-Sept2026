<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bet365Agent PoC"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Accessibility service enabled: …"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/statusPackage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Foreground package: …"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/statusTimestamp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Last scan: …"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnOpenSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Open Accessibility settings" />

        <Button
            android:id="@+id/btnRefresh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Refresh status / last scan" />

        <Button
            android:id="@+id/btnClickFootball"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Test: Click Football in Chrome" />

        <Button
            android:id="@+id/btnTestSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Test: Search Football &amp; Enter Query" />

        <Button
            android:id="@+id/btnTestFixture"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Test: Tap Fixture from Search" />

        <Button
            android:id="@+id/btnTestVisualControl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Test: Visual Control (Screenshot + OCR + Gesture)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Search flow test"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/searchResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="SEARCH_FLOW: (not run)"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/searchExcerpt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#11000000"
            android:fontFamily="monospace"
            android:padding="8dp"
            android:text="SEARCH_CHROME_TEXT: (none)"
            android:textIsSelectable="true"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Fixture tap test"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/fixtureResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="FIXTURE_TAP: (not run)"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/fixtureExcerpt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#11000000"
            android:fontFamily="monospace"
            android:padding="8dp"
            android:text="FIXTURE_CHROME_TEXT: (none)"
            android:textIsSelectable="true"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Visual control test (Screenshot + OCR + Gesture)"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/visualControlResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="VISUAL_CONTROL_TEST: (not run)"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/visualControlExcerpt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#11000000"
            android:fontFamily="monospace"
            android:padding="8dp"
            android:text="Details: (none)"
            android:textIsSelectable="true"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Football click test"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/clickFbResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="CLICK_FOOTBALL: (not run)"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/clickFbExcerpt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#11000000"
            android:fontFamily="monospace"
            android:padding="8dp"
            android:text="POST_CLICK_CHROME_TEXT: (none)"
            android:textIsSelectable="true"
            android:textSize="12sp" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Last scan (any package)"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/scanOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#11000000"
            android:fontFamily="monospace"
            android:padding="8dp"
            android:text="No scan yet."
            android:textIsSelectable="true"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="LAST CHROME SNAPSHOT"
            android:textStyle="bold"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/chromeTimestamp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Timestamp: (none yet)"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/chromeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Window title: (none yet)"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Visible text"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/chromeVisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="#11000000"
            android:fontFamily="monospace"
            android:padding="8dp"
            android:text="(none yet — open Chrome with Bet365, then Refresh)"
            android:textIsSelectable="true"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Clickable nodes (bounds / classes)"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/chromeClickable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="#11000000"
            android:fontFamily="monospace"
            android:padding="8dp"
            android:text="(none yet)"
            android:textIsSelectable="true"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Full Chrome node dump"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/chromeDump"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="#11000000"
            android:fontFamily="monospace"
            android:padding="8dp"
            android:text="(none yet)"
            android:textIsSelectable="true"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
